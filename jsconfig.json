{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "baseUrl": ".",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "jsx": "preserve",
    "checkJs": false
  },
  "vueCompilerOptions": {
    "target": 2
  },
  "include": ["src/**/*.vue", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
