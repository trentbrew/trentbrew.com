# Gallery reads the inline "Gallery" database on your Notion CMS page:
# https://app.notion.com/p/trentbrew/CMS-14313ed3c526445a800542a94896fac0
# See docs/notioncms.md

# Required for /api/v1/gallery (local dev + Vercel). Internal integration token; connect integration to CMS page.
NOTION_API_KEY=
NOTION_GALLERY_ID=f7a8e709-9b0c-4ea4-8de9-ac8744521416

# Optional: must match Authorization Bearer from the client (defaults to VUE_APP_NOTION_CMS_TOKEN).
# NOTION_CMS_TOKEN=

# Client still sends this header on gallery requests (legacy notion-cms auth).
VUE_APP_NOTION_CMS_TOKEN=

# Legacy external API (only if VUE_APP_NOTION_CMS_URL=external).
# VUE_APP_NOTION_CMS_URL=external
# VUE_APP_NOTION_CMS_HOST=https://notioncms.vercel.app

# Optional fallbacks when API fails (dev uses bundled placeholders automatically).
# VUE_APP_GALLERY_FALLBACK=true
# VUE_APP_GALLERY_FALLBACK=snapshot
